{
  "name": "@debrief/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "eval": "node --env-file=../../.env dist/run-eval.js",
    "eval:dry": "node --env-file=../../.env dist/run-eval.js --skip-judge",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@debrief/contracts": "workspace:*",
    "@debrief/core": "workspace:*",
    "@debrief/providers": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@debrief/typescript-config": "workspace:*",
    "@types/node": "^26.6.1"
  }
}
